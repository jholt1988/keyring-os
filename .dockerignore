# Dependencies (will be installed fresh in Docker)
**/node_modules
**/.pnp
**/.pnp.js

# Build output
**/.next
**/out
**/dist
**/build

# Version control
.git
.gitignore

# IDE / Editor
.vscode
.idea
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Debug logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*

# Environment files (injected at runtime)
**/.env
**/.env.*

# Docker
**/Dockerfile
**/.dockerignore
**/docker-compose*.yml

# Turbo
.turbo

# Large generated files
repomix-output*.xml

# Documentation (not needed in image)
*.md
docs/
