{
  "name": "keyring-os",
  "private": false,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test keyring-admin-auth.spec.ts",
    "test:e2e:keyring-property": "playwright test keyring-property-workflow.spec.ts",
    "test:e2e:keyring-critical": "playwright test keyring-admin-auth.spec.ts keyring-property-workflow.spec.ts",
    "test:e2e:keyring-decisions": "playwright test keyring-decision-workflows.spec.ts",
    "test:e2e:keyring-all": "playwright test keyring-admin-auth.spec.ts keyring-property-workflow.spec.ts keyring-decision-workflows.spec.ts",
    "test:e2e:workflows": "playwright test keyring-decision-workflows.spec.ts",
    "test:e2e:legacy": "playwright test auth-flow.spec.ts payment-workflow.spec.ts lease-workflow.spec.ts maintenance-workflow.spec.ts accessibility.spec.ts",
    "test:e2e:all": "playwright test",
    "test:e2e:report": "playwright test --reporter=html",
    "test:e2e:install": "npx playwright install --with-deps",
    "check:no-mock-auth": "bash scripts/check-no-mock-auth.sh",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.0",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "turbo": "^2.9.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@next/env": "^16.2.2",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.96.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  }
}
